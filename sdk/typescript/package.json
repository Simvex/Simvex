{
  "name": "simvex-client",
  "version": "0.1.0",
  "description": "TypeScript client for the Simvex paper-trading API for Solana bots. Paper trading only. No runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepare": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simvex/Simvex.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://simvex.xyz/guide"
}
